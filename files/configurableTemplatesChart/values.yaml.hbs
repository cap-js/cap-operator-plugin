serviceInstances:

serviceBindings:

app:
  # -- BTP application name (xsappname)
  domains:
    # -- primary domain to expose application routes (usually a subdomain of the cluster domain)
    primary:
    # -- References to exisiting customer specific domains
    additionalDomainRefs: []
  # -- Labels used to identify the istio ingress-gateway component and its corresponding namespace
  istioIngressGatewayLabels:
    istio: ingressgateway
    app: istio-ingressgateway
  # -- Enable cleanup monitoring for CAPApplication versions
  enableCleanupMonitoring: true

btp:
  # -- BTP Provider sub-account identifier where the application is hosted
  providerSubaccountId:
# -- Image pull secrets
imagePullSecrets: []

hanaInstanceId:

workloads:
  server:
    image:
  {{#isApp}}
  appRouter:
    image:

  tenantJob:
    image:
  {{/isApp}}
  contentDeploy:
    image:
  {{#hasAms}}
  amsDeployer:
    image:
  {{/hasAms}}
